DATABASE_URL=sqlite:///./my_time.db
# DATABASE_URL=postgresql+psycopg://my_time:my_time@localhost:5432/my_time
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Only enable on a single process. Use a dedicated worker before scaling.
RUN_SCHEDULER=false

# Persistent public website content and replacement images
WEBSITE_DATA_DIR=./website_data

# Google Business Profile reviews (OAuth web application credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/website/reviews/google/callback
